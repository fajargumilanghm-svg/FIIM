# =============================================================================
# FIIM Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# General
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173   # in prod: the deployed Vercel origin (used for CORS)

# PDF rendering — path to system Chromium (set automatically in the Docker image)
PUPPETEER_EXECUTABLE_PATH=
# Report scheduler — set to true to disable the hourly cron (e.g. in tests)
DISABLE_CRON=

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://fiim_dev:fiim_dev_password@localhost:5432/fiim_development

# Redis (Cache, Sessions, Pub/Sub)
REDIS_URL=redis://localhost:6379

# Message Queue (RabbitMQ)
RABBITMQ_URL=amqp://fiim:fiim_password@localhost:5672

# Search (Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200

# Object Storage (MinIO for local, S3 for production)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=fiim_minio
MINIO_SECRET_KEY=fiim_minio_password
MINIO_BUCKET=fiim-uploads
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=change_this_to_a_32_character_random_string
JWT_EXPIRATION=4h
REFRESH_TOKEN_EXPIRATION=7d

# Multi-Factor Authentication (MFA)
MFA_ISSUER=FIIM
MFA_ALGORITHM=sha256

# OAuth2 / SSO (Optional - leave empty for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email (SendGrid / SMTP)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@fiim.local
FROM_NAME=FIIM System

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_MFA=true
ENABLE_OAUTH=true
ENABLE_REALTIME_ALERTS=true
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_MOBILE_PWA=true

# Compliance
ENCRYPTION_KEY=change_this_to_a_32_byte_base64_key
AUDIT_RETENTION_DAYS=2555
DATA_RETENTION_YEARS=7

# Monitoring (DataDog / NewRelic - Optional)
DATADOG_API_KEY=
NEW_RELIC_LICENSE_KEY=
