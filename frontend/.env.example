# =============================================================================
# FIIM Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# API Configuration
# In production set this to the Render backend URL, e.g.
#   https://fiim-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000

# App Metadata
VITE_APP_NAME=FIIM
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Fatigue Injury Index Monitoring"

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# Analytics (Optional)
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=
